# Browser basemap key; an empty value shows the configuration notice.
# VITE values are visible in browser requests. Use an origin-restricted MapTiler maps API key.
VITE_MAPTILER_KEY=
VITE_MAPTILER_MAP_ID=outdoor-v4

# Local server-only meteorology adapter; this interpreter needs pyarrow, numpy and h3.
# Configure an interpreter path in .env.local when python3 lacks those packages.
METEOROLOGY_PYTHON=python3
# Optional path to the retained catalog and two wide Parquets.
# METEOROLOGY_SOURCE=/path/to/Data/Meteorology

# The local app reads these final delivery folders automatically; no preparation command is required.
# Server-only Python needs pyarrow, numpy, h3, shapely and pyproj. METEOROLOGY_PYTHON is a supported fallback.
# MARINECAST_DATA_PYTHON=/path/to/python
# MARINECAST_DATA_ROOT=/path/to/MarineCast/Data
# FastAPI serves all layers and Relationships on this port; Vite proxies both.
# npm run dev starts both services and reuses an already-running matching API.
# npm run backend keeps the API warm independently of npm run dev:frontend.
# Both launchers load these server-only settings from .env.local.
# MARINECAST_API_PORT=8001
# MARINECAST_RELATIONSHIPS_PORT remains a supported fallback for the same port.
# Optional completed Viewshed pilot and matching weights (Data/viewshed is not yet a completed pair product).
# VIEWSHED_PILOT=/path/to/completed/pilot
# VIEWSHED_COMPONENTS=/path/to/matching/components
