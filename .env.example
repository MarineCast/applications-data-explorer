# Optional browser map key; leave empty for the offline SVG basemap.
# VITE values are visible in browser requests. Use an origin-restricted MapTiler maps API key.
VITE_MAPTILER_KEY=
VITE_MAPTILER_MAP_ID=outdoor-v4

# Viewshed defaults to OrcaCast_Public's OpenFreeMap Bright basemap (no key).
# Optional compatible MapLibre style URL; basemap assets load in the browser.
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
