{
  "name": "marinecast-data-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "dev:frontend": "vite --host 127.0.0.1",
    "backend": "node scripts/serve.mjs backend",
    "test:api": "python3 -m unittest discover -s scripts -p 'test_data_api.py'",
    "test:relationships": "python3 -m unittest discover -s scripts -p 'test_relationships*.py'",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "h3-js": "4.3.0",
    "lucide-react": "0.468.0",
    "maplibre-gl": "6.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.9",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.2.2",
    "vitest": "4.0.14"
  }
}
